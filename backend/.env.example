# ---- Lost & Found API — environment template ----
# Copy to .env and fill in real values:  cp .env.example .env

# PostgreSQL connection string.
# Local dev : postgresql://postgres:postgres@localhost:5432/lostfound
# Free cloud: create a database at https://neon.tech and paste its URI here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lostfound"

# Auth secrets — any long random strings. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Comma-separated list of allowed browser origins (exact match).
CLIENT_URL="http://localhost:5173"

# Insert demo data (users, items, claims) on server start when tables are empty.
SEED_ON_START="false"

# Server port (defaults to 5000).
PORT="5000"
